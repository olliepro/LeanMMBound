module

public import FKLMeta.Shapes
public import FKLMeta.Walk
public import DyadicOrbitSupport
public import VerifiedOrbitSupportTables

/-! Raw support checks of sparse orbit rows against the coarse orbit totals `OrbitLevelN.totalAt`
(packed into 5-bit lanes). Generated by `gen_support.py`. -/

@[expose] public section

namespace FKLMeta.Support

open MatrixBounds.Numeric

/-- `OrbitLevel2.totalAt` on its 6 orbits, 5-bit lanes. -/
def total2 : ℕ := 0x8310820

theorem total2_checked : FKLMeta.walk (fun c v => Nat.beq v (FKL.lane total2 5 c)) OrbitLevel2.totalTable.toList 0 = true := by
  decide +kernel

theorem total2_len : OrbitLevel2.totalTable.toList.length = 6 := by decide +kernel

theorem total2_eq : ∀ c < 6, OrbitLevel2.totalAt c = FKL.lane total2 5 c := by
  intro c hc
  have hc' : c < OrbitLevel2.totalTable.toList.length := by rw [total2_len]; exact hc
  have e := Nat.eq_of_beq_eq_true (FKLMeta.walk_sound _ _ 0 total2_checked c hc')
  rw [Nat.zero_add] at e
  unfold OrbitLevel2.totalAt
  rw [← Array.getElem?_toList, List.getElem?_eq_getElem hc', Option.getD_some, e]

