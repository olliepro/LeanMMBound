/-- `OrbitLevel4.totalAt` on its 231 orbits, 5-bit lanes. -/
def total4 : ℕ := 0x41ee7358e6b18d62d6a62d4a4a1cd6316a6358b5a92b5316a5250a4a18b52928525086b16b5256a4a54c5a949429284250b525283a5073a0e65a92941d2839d0731949420e641cc6398a52316a5250a4a10941ce642d494a0e941ce8398c539949420e641cc6398a5218a45250839907318e6294862908941ce629cc5298a420ca418c48398c5218a4214831888310820

theorem total4_checked : FKLMeta.walk (fun c v => Nat.beq v (FKL.lane total4 5 c)) OrbitLevel4.totalTable.toList 0 = true := by
  decide +kernel

theorem total4_len : OrbitLevel4.totalTable.toList.length = 231 := by decide +kernel

