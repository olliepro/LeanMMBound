/-- Every sparse column is below `W` and has coarse total `target` in the packed table `T`. -/
def supF (T W target : ℕ) (es : List (ℕ × ℕ)) : Bool :=
  List.rec (motive := fun _ => Bool) true
    (fun e _ acc => Bool.and (Bool.and (Nat.blt e.1 W) (Nat.beq (FKL.lane T 5 e.1) target)) acc) es

theorem supF_sound (T W target : ℕ) (stat : ℕ → ℕ) (hs : ∀ c < W, stat c = FKL.lane T 5 c) :
    ∀ es : List (ℕ × ℕ), supF T W target es = true → es.all (fun e => decide (stat e.1 = target)) = true := by
  intro es
  induction es with
  | nil => intro _; rfl
  | cons e es ih =>
    intro h
    change Bool.and (Bool.and (Nat.blt e.1 W) (Nat.beq (FKL.lane T 5 e.1) target)) (supF T W target es) = true at h
    simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq] at h
    simp only [List.all_cons, Bool.and_eq_true, decide_eq_true_eq]
    exact ⟨by rw [hs _ h.1.1]; exact h.1.2, ih h.2⟩

theorem supportCheck_of (T W target : ℕ) (stat : ℕ → ℕ) (hs : ∀ c < W, stat c = FKL.lane T 5 c)
    (row : DyadicRow) (h : supF T W target row.entries = true) : row.supportCheck stat target = true :=
  supF_sound T W target stat hs row.entries h

/-- Fast form of the zero-registry row test. -/
def zeroRowF (code : ℕ) (row : DyadicRow) : Bool :=
  cond (Nat.beq code 0) true
    (cond (Nat.beq row.width 6) (supF total2 6 (Nat.sub code 1) row.entries)
    (cond (Nat.beq row.width 21) (supF total3 21 (Nat.sub code 1) row.entries)
    (cond (Nat.beq row.width 231) (supF total4 231 (Nat.sub code 1) row.entries) false)))

theorem zeroRow_sound (code : ℕ) (row : DyadicRow) (h : zeroRowF code row = true) :
    (if code = 0 then true
    else if row.width = 6 then row.supportCheck OrbitLevel2.totalAt (code-1)
    else if row.width = 21 then row.supportCheck OrbitLevel3.totalAt (code-1)
    else if row.width = 231 then row.supportCheck OrbitLevel4.totalAt (code-1)
    else false) = true := by
  unfold zeroRowF at h
  cases h0 : Nat.beq code 0
  · rw [h0, cond_false] at h
    rw [if_neg (Nat.ne_of_beq_eq_false h0)]
    cases h6 : Nat.beq row.width 6
    · rw [h6, cond_false] at h
      rw [if_neg (Nat.ne_of_beq_eq_false h6)]
      cases h21 : Nat.beq row.width 21
      · rw [h21, cond_false] at h
        rw [if_neg (Nat.ne_of_beq_eq_false h21)]
        cases h231 : Nat.beq row.width 231
        · rw [h231, cond_false] at h; exact absurd h (by simp)
        · rw [h231, cond_true] at h
          rw [if_pos (Nat.eq_of_beq_eq_true h231)]
          exact supportCheck_of _ _ _ _ total4_eq row h
      · rw [h21, cond_true] at h
        rw [if_pos (Nat.eq_of_beq_eq_true h21)]
        exact supportCheck_of _ _ _ _ total3_eq row h
    · rw [h6, cond_true] at h
      rw [if_pos (Nat.eq_of_beq_eq_true h6)]
      exact supportCheck_of _ _ _ _ total2_eq row h
  · rw [if_pos (Nat.eq_of_beq_eq_true h0)]

end FKLMeta.Support
