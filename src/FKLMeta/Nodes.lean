/-! Packed copies of the shape enumerations `shapes 4/8/16`, the hierarchy node arrays and the child-column
lists of `SuppliedShapeIndices`, each linked to the original by one walk. Generated by `gen_nodes.py`. -/

@[expose] public section

namespace FKLMeta.Nodes

open MatrixBounds.Numeric SuppliedShapeIndices
set_option maxRecDepth 100000

def sx4 : ℕ := 0x1063108410842000000
def sy4 : ℕ := 0x20104031040418820
def sz4 : ℕ := 0x1004400886008864

theorem shapes4_checked : FKLMeta.walk (fun c s => Bool.and (Nat.beq s.x (FKL.lane sx4 5 c))
    (Bool.and (Nat.beq s.y (FKL.lane sy4 5 c)) (Nat.beq s.z (FKL.lane sz4 5 c)))) (shapes 4) 0 = true := by
  decide +kernel

theorem shapes4_len : (shapes 4).length = 15 := by decide +kernel

theorem shapes4_get (c : ℕ) (hc : c < 15) :
    (shapes 4)[c]? = some ⟨FKL.lane sx4 5 c, FKL.lane sy4 5 c, FKL.lane sz4 5 c⟩ := by
  have hc' : c < (shapes 4).length := by rw [shapes4_len]; exact hc
  have e := FKLMeta.walk_sound _ _ 0 shapes4_checked c hc'
  simp only [Nat.zero_add, Bool.and_eq_true, Nat.beq_eq] at e
  rw [List.getElem?_eq_getElem hc', ← e.1, ← e.2.1, ← e.2.2]

theorem shapeAt4 (c : ℕ) (hc : c < 15) :
    shapeAt 4 c = ⟨FKL.lane sx4 5 c, FKL.lane sy4 5 c, FKL.lane sz4 5 c⟩ := by
  unfold shapeAt; rw [shapes4_get c hc]; rfl

