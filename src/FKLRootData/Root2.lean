public import RateCertificateData.Root2Block001

@[expose] public section

namespace MatrixBounds.Numeric.FKLRootData.Root2

open FKL FKLCert FKLRoot

/-- Both original certificate blocks of root fine axis 1. -/
def terms : List IntegerLogTerm :=
  RateCertificateData.Root2Block000.terms ++ RateCertificateData.Root2Block001.terms

def keys : Nat := 

theorem exact_check : allExact 450 450 terms = true := by decide +kernel

theorem check : check2 454 keys 459 927 10 (rootRaw 1) (certRaw 450 450 terms) = true := by decide +kernel

theorem value : rawValue 450 450 (rootRaw 1) = rationalLogValue (terms.map IntegerLogTerm.monomial) := by
  rw [check2_sound 450 450 454 keys 459 927 10 _ _ check, certRaw_value 450 450 terms exact_check]

end MatrixBounds.Numeric.FKLRootData.Root2
