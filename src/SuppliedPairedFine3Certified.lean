/-- The actual normalized level-3 fine rate on physical axis 2 equals its supplied certificate. -/
theorem level3_rate2 : SuppliedPathStages.level3.rates 2/(SuppliedPopulationWeights.rootWeight : ℝ) =
    CertifiedLevel3Rate2.value := by
  have identity := normalized_stage_rate3 1
  rw [expression_eq1] at identity
  exact identity

end MatrixBounds.Numeric.SuppliedPairedFine.SuppliedPairedFine3Certified
