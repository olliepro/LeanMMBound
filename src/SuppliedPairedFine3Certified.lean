/-- The complete original fine source expression on axis 0 is exactly its independent certificate. -/
theorem expression_eq0 : rationalLogValue (expression3 0) = CertifiedLevel3Rate1.value := by
  rw [expression3_blocks]
  simp_rw [boundaries0]
  rw [Finset.sum_add_distrib, PairedFine3TableA0.windows_value, PairedFine3CorrectionsA0.cancelled, add_zero]

/-- The actual normalized level-3 fine rate on physical axis 1 equals its supplied certificate. -/
theorem level3_rate1 : SuppliedPathStages.level3.rates 1/(SuppliedPopulationWeights.rootWeight : ℝ) =
    CertifiedLevel3Rate1.value := by
  have identity := normalized_stage_rate3 0
  rw [expression_eq0] at identity
  exact identity
