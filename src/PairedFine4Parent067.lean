/-- Literal children preserve the complete original parent4 integer law. -/
theorem source_eq (axis : Fin 3) (orbit : Fin 231) :
    source axis orbit = SuppliedRootFineParent4Integers.numerator 67 axis orbit := by
  have childrenEq : (fun column => PairedFine4Children067.numerator column axis) =
      fun column => RootFineCachedParent4.child PairedFine4Children067.parent3 67 column axis := by
    funext column orbit
    rw [PairedFine4Children067.numerator_eq, RootFineCachedParent4.child_eq _ PairedFine4Children067.parent3_eq]
  rw [source, childrenEq]
  exact RootFineCachedParent4.numerator_eq _ PairedFine4Children067.parent3_eq 67 axis orbit

/-- Every parent4 source orbit mass is nonnegative. -/
theorem source_nonnegative (axis : Fin 3) (orbit : Fin 231) : 0 ≤ source axis orbit := by
  rw [source_eq]
  exact SuppliedRootFineParent4Integers.numerator_nonnegative 67 axis orbit

/-- Every complete parent4 source vector has total 2^406. -/
theorem source_normalized (axis : Fin 3) : ∑ orbit, source axis orbit = (2:ℤ)^406 := by
