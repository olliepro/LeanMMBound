/-- The bounded checks cover every supplied index without an unchecked remainder. -/
theorem recursive_sizes_checked (index : Fin 231) : recursive_sizes_checked_predicate index :=
  fkl_sizes index


/-- Every supplied size is the actual number of complete fine words in its verified orbit. -/
theorem sizes_correct (orbit : Fin 231) : orbits.size orbit = sizes orbit := by
  unfold orbits
  rw [PairEncoding.wordOrbits_size, PairEncoding.pairOrbit_size_evaluator]
  have childSizes : MatrixBounds.Numeric.OrbitLevel3.orbits.size = MatrixBounds.Numeric.OrbitLevel3.sizes := funext MatrixBounds.Numeric.OrbitLevel3.sizes_correct
  rw [childSizes]
  exact recursive_sizes_checked orbit

end MatrixBounds.Numeric.OrbitLevel4
