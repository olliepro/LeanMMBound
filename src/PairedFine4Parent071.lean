/-- The complete original parent law evaluated from the checked literal children. -/
def source (axis : Fin 3) (orbit : Fin 231) : ℤ :=
  SuppliedRootFineParent3Integers.sparseIntegerParent (RootFineCachedParent4.weight 71)
    (RootFineCachedParent4.complement 71) OrbitLevel4.sizes OrbitLevel4.encoding.columns
