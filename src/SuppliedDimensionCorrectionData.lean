/-- Every exact shared-logarithm correction coefficient cancels completely. -/
theorem checked : mergeNormalizeLogExpression (finiteLogSum corrections) = [] := by decide +kernel

/-- The complete correction family has exactly zero real logarithmic value. -/
theorem value_zero : (∑ block, rationalLogValue (corrections block)) = 0 :=
  SuppliedTerminalRates.sum_corrections_zero corrections checked

