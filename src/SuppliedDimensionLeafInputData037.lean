/-- Complete original zero2 source order through the seven short exact node tables. -/
def zeroInputs (index : Fin (7*72)) : Zero2Input := zeroInputRows index.divNat index.modNat

/-- Complete original terminal source order through the seven short exact node tables. -/
def terminalInputs (index : Fin (7*18)) : TerminalInput := terminalInputRows index.divNat index.modNat

/-- Full zero2 and terminal dimension expression evaluated from exact checked integer inputs. -/
def expression : RationalLogExpression :=
  finiteLogSum (fun index => zero2InputExpression (zeroInputs index)) ++
    finiteLogSum (fun index => terminalInputExpression (terminalInputs index))

