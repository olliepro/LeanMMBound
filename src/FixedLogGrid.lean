/-- Read integer endpoints for one proved logarithm grid entry. -/
def bounds (index : Fin 256) : FixedBounds :=
  match index.val/16 with
  | 0 => block00[index.val%16]?.getD ⟨0, 0⟩
  | 1 => block01[index.val%16]?.getD ⟨0, 0⟩
  | 2 => block02[index.val%16]?.getD ⟨0, 0⟩
  | 3 => block03[index.val%16]?.getD ⟨0, 0⟩
  | 4 => block04[index.val%16]?.getD ⟨0, 0⟩
  | 5 => block05[index.val%16]?.getD ⟨0, 0⟩
  | 6 => block06[index.val%16]?.getD ⟨0, 0⟩
  | 7 => block07[index.val%16]?.getD ⟨0, 0⟩
  | 8 => block08[index.val%16]?.getD ⟨0, 0⟩
  | 9 => block09[index.val%16]?.getD ⟨0, 0⟩
  | 10 => block10[index.val%16]?.getD ⟨0, 0⟩
  | 11 => block11[index.val%16]?.getD ⟨0, 0⟩
  | 12 => block12[index.val%16]?.getD ⟨0, 0⟩
  | 13 => block13[index.val%16]?.getD ⟨0, 0⟩
  | 14 => block14[index.val%16]?.getD ⟨0, 0⟩
  | 15 => block15[index.val%16]?.getD ⟨0, 0⟩
  | _ => ⟨0, 0⟩

/-- Every stored integer pair is exactly the previously certified rational interval. -/
theorem interval_correct : ∀ index : Fin 256,
    (bounds index).interval (2^60) = (CertifiedLogGrid.entry index).bounds := by decide +kernel

/-- The integer grid encloses each actual real grid logarithm. -/
theorem sound (index : Fin 256) :
    ((bounds index).interval (2^60)).Contains (Real.log ((1+(index.val : ℚ)/256 : ℚ) : ℝ)) := by
  rw [interval_correct]
  exact CertifiedLogGrid.bounds_sound index

end MatrixBounds.Numeric.FixedLogGrid
