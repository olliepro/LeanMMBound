module

public import FixedLogGrid

/-! The fixed logarithm grid as two packed 64-bit lane tables: `gridLo` stores `lower+1`, `gridHi` stores `upper`. -/

@[expose] public section

namespace MatrixBounds.Numeric.FKLLog

/-- Lanes `lower+1` of `FixedLogGrid.bounds`. -/
def gridLo : Nat := 

/-- Lanes `upper` of `FixedLogGrid.bounds`. -/
def gridHi : Nat := 

/-- Raw 64-bit lane read. -/
def lane64 (d i : Nat) : Nat := Nat.land (Nat.shiftRight d (Nat.mul 64 i)) 18446744073709551615

/-- The packed tables read back the integer grid exactly. -/
theorem grid_eq : ∀ g : Fin 256, FixedLogGrid.bounds g = ⟨(lane64 gridLo g.val : ℤ) - 1, (lane64 gridHi g.val : ℤ)⟩ := by
  decide +kernel

end MatrixBounds.Numeric.FKLLog
