/-- The complete original parent law evaluated from the checked literal children. -/
def source (axis : Fin 3) (orbit : Fin 231) : ℤ :=
  SuppliedRootFineParent3Integers.sparseIntegerParent (RootFineCachedParent4.weight 61)
    (RootFineCachedParent4.complement 61) OrbitLevel4.sizes OrbitLevel4.encoding.columns
