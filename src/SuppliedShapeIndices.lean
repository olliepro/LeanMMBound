import SplitData

/-! Complete original shape and node indexing. The expected node enumerations
use only formal shape support, independent of every probability value. -/
namespace MatrixBounds.Numeric.SuppliedShapeIndices
set_option maxRecDepth 100000
set_option maxHeartbeats 16000000

/-- A source hierarchy row names its parent, complete child column, and positive/zero child column. -/
structure HierarchyNode where
  parent : ℕ
  child : ℕ
  localChild : ℕ
  deriving DecidableEq

/-- All three coordinates are positive precisely for ordinary paired extraction children. -/
def positiveShape (shape : Shape) : Bool := decide (0 < shape.x ∧ 0 < shape.y ∧ 0 < shape.z)

/-- Exact lexicographic child columns in either the positive or zero-coordinate sector. -/
def childColumns (total : ℕ) (positive : Bool) : List ℕ :=
  ((shapes total).zipIdx.filter (fun entry => positiveShape entry.1 == positive)).map Prod.snd

/-- Select a formal shape column; proved index bounds eliminate the fallback in every source node. -/
def shapeAt (total column : ℕ) : Shape := (shapes total)[column]?.getD ⟨0,0,0⟩

/-- Complete admissible node enumeration, with parent and child order inherited from the source alphabets. -/
def expectedNodes (positive : Bool) : List HierarchyNode :=
  ((childColumns 16 true).zipIdx).flatMap (fun parent =>
    ((childColumns 8 positive).zipIdx).filterMap (fun child =>
      if (shapeAt 8 child.1).Fits (shapeAt 16 parent.1) then
        some ⟨parent.2, child.1, child.2⟩ else none))

